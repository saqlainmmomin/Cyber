+"""S7 group "narrative": seeds for b5-narrative and b5-board-inputs.
+
+Both pages read the approved findings of a released report, so every state starts from the same
+builder: approved conclusions, a real ``record_release`` (omitted for the not-released state), findings
+and actions created through ``app.services.findings.create_finding``. Narrative drafts and acceptances
+are the real audit events written by ``app.services.narrative`` (``_write_event``), with the real basis
+hashes, so ``narrative.state()`` reports them exactly as the page would see them after a live run.
+
+States that no stored data can produce (the in-flight "generating" request, the board-input
+validation errors, which the live endpoints answer with a toast and never render) go through
+``app/routers/design_s7_narrative.py`` and are marked ``preview-state``.
+"""
+
+from __future__ import annotations
+
+import json
+
+from app.models.action import Action
+from app.models.conclusion import Conclusion, ConclusionRevision
+from app.models.finding import Finding
+from app.models.initiative_metadata import InitiativeMetadata
+from design.harness.seed_s4 import SEED_ACTOR, _time
+
+SCREEN_STATES = {
+    "b5-narrative": ("empty", "generating", "drafted", "partly-accepted", "accepted", "error", "not-released"),
+    "b5-board-inputs": ("empty", "partly", "complete", "dense", "error"),
+}
+
+# (framework, control index, title, description, severity, priority, why it matters, recommendation,
+#  [(action title, responsibility)]). Severity then priority decide the F1..Fn aliases, so the list
+# order is the alias order.
+BREACH = ("dpdpa", 0, "Breach notification process", "No route exists to notify the Board and affected data principals within the required window.", "high", 1,
+          "A late or missed notification exposes the company to regulatory action and loss of customer trust.",
+          "Add a notification step to the incident procedure with named owners and a template.",
+          [("Add notification step to the incident procedure", "client"), ("Review the template with legal counsel", "shared")])
+CONSENT = ("dpdpa", 1, "Consent withdrawal mechanism", "Withdrawal is possible only by emailing the data protection officer.", "high", 2,
+           "Customers cannot withdraw consent as easily as they gave it, which the Act requires.",
+           "Add a withdrawal control to account settings.",
+           [("Build the withdrawal control", "client")])
+NOTICE = ("dpdpa", 2, "Notice in regional languages", "The privacy notice is available in English only.", "high", 3, "", "",
+          [("Translate the notice", "client"), ("Check the translation", "consultant")])
+BACKUPS = ("dpdpa", 3, "Backups not encrypted at rest", "Backups of the payments database are stored unencrypted.", "medium", 1, "", "",
+           [("Enable encryption on backup storage", "client")])
+RETENTION = ("dpdpa", 4, "Data retention schedule", "No retention schedule covers customer records.", "medium", 2, "", "",
+             [("Publish a retention schedule", "")])
+ACCESS = ("iso27001", 0, "Access rights", "Access reviews skip some production systems.", "medium", 3, "", "",
+          [("Extend the access review to production systems", "")])
+RECOVERY = ("iso27001", 1, "Disaster recovery testing", "The last recovery test missed its objective.", "low", 1, "", "",
+            [("Re-run the recovery test", "")])
+SUPPLIER = ("iso27001", 2, "Supplier security reviews", "Some payment processors have no supplier review on file.", "low", 2, "", "",
+            [("Review the payment processors", "")])
+
+NARRATIVE_SPEC = [BREACH, CONSENT, NOTICE, BACKUPS, RETENTION, ACCESS, RECOVERY, SUPPLIER]
+
+DENSE_SPEC = [
+    BREACH, CONSENT, NOTICE, BACKUPS,
+    ("iso27001", 0, "Access reviews skip production systems", "Quarterly reviews leave out the payments estate.", "medium", 1, "", "", [("Extend the access review", "client")]),
+    ("iso27001", 1, "Disaster recovery test missed its objective", "The last recovery test overran its objective.", "medium", 2, "", "", [("Re-run the recovery test", "shared")]),
+    ("iso27001", 2, "Supplier security reviews missing", "Payment processors have no review on file.", "medium", 3, "", "", [("Review the payment processors", "")]),
+    ("dpdpa", 4, "Data retention schedule", "No retention schedule covers customer records.", "low", 1, "", "", [("Publish a retention schedule", "client")]),
+    ("iso27001", 3, "Privileged access list incomplete", "Not every privileged account has a named owner.", "low", 2, "", "", [("Name an owner for each privileged account", "")]),
+    ("iso27001", 4, "Incident register lacks severity", "Incidents are logged without a severity.", "low", 3, "", "", [("Add severity to the incident register", "")]),
+    ("dpdpa", 5, "Vendor onboarding skips privacy checks", "New vendors are onboarded without a privacy review.", "low", 4, "", "", [("Add a privacy check to vendor onboarding", "")]),
+    ("iso27001", 5, "Staff awareness training not tracked", "Completion of awareness training is not recorded.", "low", 4, "", "", [("Track training completion", "consultant")]),
+]
+
+COMPLETE_SPEC = [
+    BREACH[:6] + ("A late or missed notification exposes the company to regulatory action and loss of customer trust.",
+                  "Add a notification step to the incident procedure with named owners and a template.",
+                  [("Add notification step to the incident procedure", "client"), ("Review the template with legal counsel", "shared")]),
+    CONSENT[:6] + ("Customers cannot withdraw consent as easily as they gave it, which the Act requires.",
+                   "Add a withdrawal control to account settings.", [("Build the withdrawal control", "client")]),
+    ACCESS[:5] + (1, "Unreviewed access can stay active for longer than intended.",
+                  "Extend the access review to every production system.", [("Extend the access review to production systems", "consultant")]),
+]
+
+ASKS = ["Approve funding for the incident response work", "Name an executive owner for the access review programme", "Set the date for the next recovery test"]
+
+NARRATIVE_TEXT = {
+    "executive": [
+        ("Meridian Ledger Technologies has documented most of what a privacy and security programme needs, but some controls do not yet work as written.", (1, 6)),
+        ("The most serious gaps are where customers act on their data and where incidents must be reported.", (1, 2)),
+        ("Closing the access review and incident notification gaps would reduce the most exposure.", (1, 6)),
+    ],
+    "cross-framework": [
+        ("Under both frameworks, controls exist on paper but are not applied everywhere.", (4, 6)),
+        ("Access to some production systems is not reviewed, and backups are not encrypted at rest, which weakens safeguards the policies already promise.", (4, 6)),
+    ],
+    "framework-dpdpa": [
+        ("The record of processing and the incident register are in place.", (1,)),
+        ("Consent can be withdrawn only by emailing the data protection officer, the privacy notice is in English only, and the breach procedure has no route to notify affected data principals.", (1, 2, 3)),
+    ],
+    "framework-iso27001": [
+        ("The management system is documented and the policy set is current.", (6,)),
+        ("Operation lags the documents: access reviews skip some production systems, the last recovery test missed its objective, and some payment processors have no supplier review on file.", (6, 7, 8)),
+    ],
+}
+SECTION_ORDER = ("executive", "cross-framework", "framework-dpdpa", "framework-iso27001")
+
+
+def _seed_findings(db, assessment, spec, *, release: bool = True) -> None:
+    """Approved conclusions for the spec's controls, the release, then one finding per spec row."""
+    from app.frameworks.registry import FrameworkRegistry
+    from app.models.report import GapReport
+    from app.services import approved_report
+    from app.services import findings as finding_service
+
+    controls = {
+        framework_id: FrameworkRegistry.get_all_controls(framework_id) for framework_id in assessment.frameworks
+    }
+    applicable = [controls[row[0]][row[1]].id for row in spec]
+    assessment.applicable_requirements = json.dumps(applicable)
+    assessment.scope_answers = json.dumps({})
+    db.add(GapReport(id=f"gap-report-{assessment.id}", assessment_id=assessment.id, overall_score=0.0,
+                     chapter_scores="{}", executive_summary="Seeded analysis report.", raw_ai_response="{}",
+                     framework_scores=None, generated_at=_time(-12)))
+    db.flush()
+    conclusions = []
+    for index, row in enumerate(spec):
+        framework_id, control_index, title, description, severity = row[:5]
+        control = controls[framework_id][control_index]
+        conclusion = Conclusion(
+            id=f"conclusion-narrative-{assessment.id}-{index}", assessment_id=assessment.id,
+            framework_id=framework_id, requirement_id=control.id, outcome="partially_compliant",
+            rationale="Seeded approved conclusion.", evidence_summary="Seeded evidence summary.",
+            gaps_identified=description, risk_level=severity, recommended_action=row[7] or "Close the gap.",
+            ai_proposed=True, created_at=_time(-12), updated_at=_time(-11),
+        )
+        db.add(conclusion)
+        db.flush()
+        db.add(ConclusionRevision(id=f"revision-proposed-{conclusion.id}", conclusion_id=conclusion.id,
+                                  actor="system:analysis", action="proposed", created_at=_time(-12)))
+        db.add(ConclusionRevision(id=f"revision-approved-{conclusion.id}", conclusion_id=conclusion.id,
+                                  actor=SEED_ACTOR, action="approved", created_at=_time(-11)))
+        conclusions.append(conclusion)
+    db.flush()
+    if release:
+        approved_report.record_release(db, assessment, actor=SEED_ACTOR)
+        db.flush()
+    for conclusion, row in zip(conclusions, spec):
+        _framework_id, _index, title, description, severity, priority, impact, recommendation, actions = row
+        finding = finding_service.create_finding(
+            db, assessment_id=assessment.id, conclusion_id=conclusion.id, conclusion_version=conclusion.version,
+            title=title, description=description, severity=severity, priority=priority,
+            action_title=actions[0][0], action_owner=None, action_target_date=None, notes=None, actor=SEED_ACTOR,
+        )
+        finding.business_impact = impact or None
+        finding.recommendation = recommendation or None
+        first = db.query(Action).filter(Action.finding_id == finding.id).one()
+        first.responsibility = actions[0][1] or None
+        for position, (action_title, responsibility) in enumerate(actions[1:], start=1):
+            db.add(Action(id=f"action-{finding.id}-{position}", finding_id=finding.id, title=action_title,
+                          owner=None, responsibility=responsibility or None, status="open", history_json="[]",
+                          created_at=_time(-10), updated_at=_time(-10)))
+    db.flush()
+
+
+def _seed_narrative(db, assessment, statuses: dict[str, str]) -> None:
+    """Write drafted / accepted events for each section; ``statuses`` maps section id to
+    draft, accepted, accepted-stale or none."""
+    from app.services import narrative
+
+    refs = narrative.finding_refs(db, assessment)
+    section_ids = narrative.section_ids(assessment, refs)
+    for section_id in SECTION_ORDER:
+        status = statuses.get(section_id, "none")
+        if status == "none" or section_id not in section_ids:
+            continue
+        sentences = [
+            {"text": text, "finding_ids": [refs[number - 1].finding_id for number in numbers]}
+            for text, numbers in NARRATIVE_TEXT[section_id]
+        ]
+        basis = narrative._basis_sha256(section_id, refs)
+        draft = narrative._write_event(
+            db, actor=SEED_ACTOR, action=narrative.AUDIT_DRAFTED, assessment_id=assessment.id,
+            metadata={"section_id": section_id, "basis_sha256": basis, "status": "ok", "sentences": sentences,
+                      "dropped": [], "prompt_sha256": narrative.prompt_sha256(), "prompt_version": narrative.PROMPT_VERSION,
+                      "calls": [], "error_type": None},
+        )
+        if status.startswith("accepted"):
+            narrative._write_event(
+                db, actor=SEED_ACTOR, action=narrative.AUDIT_ACCEPTED, assessment_id=assessment.id,
+                metadata={"section_id": section_id,
+                          "basis_sha256": "0" * 64 if status == "accepted-stale" else basis,
+                          "sentences": sentences, "source_event_id": draft.id},
+            )
+    db.flush()
+
+
+def _seed_board(db, assessment, state: str) -> None:
+    from app.services import board_inputs, report_content, remediation_groups
+
+    if state == "empty":
+        return
+    spec = {"partly": [BREACH, CONSENT, NOTICE, BACKUPS], "complete": COMPLETE_SPEC, "dense": DENSE_SPEC,
+            "error": [BREACH, CONSENT]}[state]
+    _seed_findings(db, assessment, spec)
+    findings = report_content.assessment_findings(db, assessment).findings
+    groups = remediation_groups.build_groups(findings, assessment.frameworks)
+    saved = {"partly": (0, 2), "complete": (0, 1, 2), "error": (0,)}.get(state, ())
+    for position in saved:
+        if position >= len(groups):
+            continue
+        group = groups[position]
+        db.add(InitiativeMetadata(
+            assessment_id=assessment.id, group_id=group["group_id"],
+            title={0: "Strengthen incident response", 1: "Close access review gaps", 2: "Fix the notice"}.get(position, "Initiative"),
+            complexity="high" if position == 0 else "low", benefit="high" if position == 0 else None,
+        ))
+    if state in ("partly", "complete", "error"):
+        assessment.board_asks_json = json.dumps(
+            {"asks": ASKS[:3] if state == "complete" else ASKS[:1], "by": "Priya Sharma"}
+        )
+    db.flush()
+
+
+def apply(db, screen, state, assessment, engagement, data) -> dict:
+    if screen == "b5-board-inputs":
+        _seed_board(db, assessment, state)
+        if state == "error":
+            return {"data_state": "preview-state", "note": "Stored rows come from the database; the over-limit text and the limit errors are drawn by the design preview because the live save endpoints reject long text with a toast and keep the page unchanged."}
+        return {"data_state": "database", "note": "Findings, actions, initiative metadata and board decisions seeded through the real services; saved indicators come from the stored values."}
+
+    spec = NARRATIVE_SPEC
+    _seed_findings(db, assessment, spec, release=state != "not-released")
+    if state == "not-released":
+        return {"data_state": "database", "note": "Approved conclusions and findings exist but no release is recorded, so approved_report.is_released is false (drafting and accepting return 403)."}
+    statuses = {
+        "drafted": {key: "draft" for key in SECTION_ORDER},
+        "partly-accepted": {"executive": "accepted", "cross-framework": "draft", "framework-dpdpa": "accepted", "framework-iso27001": "accepted-stale"},
+        "accepted": {key: "accepted" for key in SECTION_ORDER},
+        "error": {key: "accepted" for key in SECTION_ORDER},
+    }.get(state, {})
+    _seed_narrative(db, assessment, statuses)
+    if state == "generating":
+        return {"data_state": "preview-state", "note": "The in-flight request is drawn by the design preview (generating=True) on top of the empty database state."}
+    if state == "error":
+        return {"data_state": "preview-state", "note": "The failure and draft-limit toasts are response headers (X-Toast-Message), not page markup; the page is the accepted state. Toast headers are covered by tests/test_yozora_s7_narrative.py."}
+    return {"data_state": "database", "note": "Narrative audit events written with narrative._write_event and the real basis hashes."}
+
+
+def route(screen: str, state: str, assessment_id: str) -> str:
+    if screen == "b5-narrative":
+        if state == "generating":
+            return f"/design/pages/b5-narrative?state=generating&assessment_id={assessment_id}"
+        return f"/assessments/{assessment_id}/narrative"
+    if state == "error":
+        return f"/design/pages/b5-board-inputs?state=error&assessment_id={assessment_id}"
+    return f"/assessments/{assessment_id}/board-inputs"

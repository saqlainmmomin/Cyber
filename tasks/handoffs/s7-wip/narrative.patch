     return _toast(response, message, "error")
 
 
+_LABEL_SUFFIX = re.compile(r"\s*\([a-z0-9_-]+\)$")
+
+
+def short_label(label: str) -> str:
+    """The section label without its trailing ``(section-id)``: "Executive overview"."""
+    return _LABEL_SUFFIX.sub("", label)
+
+
+def short_blocker(blocker: str) -> str:
+    """A report blocker ("Executive overview (executive): ...") without the section id."""
+    head, separator, rest = blocker.partition(": ")
+    return f"{short_label(head)}{separator}{rest}"
+
+
+def generate_toast_message(outcomes: dict[str, str], labels: dict[str, str]) -> str:
+    """Toast copy for draft failures and the draft limit; empty when every section drafted or was skipped."""
+    failed = [labels.get(section_id, section_id) for section_id, value in outcomes.items() if value == "failed"]
+    limited = [labels.get(section_id, section_id) for section_id, value in outcomes.items() if value == "limit_reached"]
+    parts = []
+    if failed:
+        parts.append(
+            f"{', '.join(failed)} could not be drafted. The section stays as it was. Write it yourself or try again."
+        )
+    if limited:
+        parts.append(f"Draft limit reached for {', '.join(limited)}. Write this section yourself.")
+    return " ".join(parts)
+
+
+def _section_view(section, ref_by_id: dict[str, str]) -> dict:
+    """One narrative section as the page shows it: label, status line, edit text and cited aliases."""
+    lines = []
+    cites: list[str] = []
+    for sentence in section.sentences:
+        aliases = [ref_by_id[finding_id] for finding_id in sentence.get("finding_ids", []) if finding_id in ref_by_id]
+        lines.append(f"{sentence.get('text', '')} [{', '.join(aliases)}]")
+        cites.extend(alias for alias in aliases if alias not in cites)
+    warn = ""
+    if section.status == "none":
+        status_label, tone = "Not drafted", "c-insuf"
+    elif section.status == "draft":
+        status_label, tone = "Draft, not accepted", "c-accent"
+    else:
+        status_label, tone = "Accepted", "c-ok"
+    if section.stale and section.status != "none":
+        warn = "Findings changed since this was written"
+    return {
+        "section": section,
+        "label": short_label(section.label),
+        "text": "\n".join(lines),
+        "cites": sorted(cites, key=lambda alias: (len(alias), alias)),
+        "status_label": status_label,
+        "tone": tone,
+        "warn": warn,
+        "needs_accept": section.status == "draft" or (section.status == "accepted" and section.stale),
+    }
+
+
+def narrative_page_context(db: Session, assessment: Assessment, **overrides) -> dict:
+    """Everything pages/narrative.html needs; the design previews pass ``overrides``."""
+    current_state = narrative.state(db, assessment)
+    ref_by_id = {ref.finding_id: ref.alias for ref in current_state.findings}
+    engagement = db.get(Engagement, assessment.engagement_id) if assessment.engagement_id else None
+    context = {
+        "assessment": assessment,
+        "engagement": engagement,
+        "period": engagement_period(engagement) if engagement else None,
+        "state": current_state,
+        "sections": [_section_view(section, ref_by_id) for section in current_state.sections],
+        "released": approved_report.is_released(db, assessment),
+        "blockers": [short_blocker(blocker) for blocker in narrative.report_blockers(db, assessment)],
+        "reviewer_name": "",
+        "generating": False,
+    }
+    context.update(overrides)
+    return context
+
+
 def _redirect_success(assessment_id: str, payload: dict) -> JSONResponse:
     response = JSONResponse(payload)
     response.headers["HX-Redirect"] = f"/assessments/{assessment_id}/narrative"

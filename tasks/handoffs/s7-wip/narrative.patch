diff --git a/app/routers/design_s7_narrative.py b/app/routers/design_s7_narrative.py
new file mode 100644
index 0000000..81aadb1
--- /dev/null
+++ b/app/routers/design_s7_narrative.py
@@ -0,0 +1,80 @@
+"""Design previews for the S7 narrative group (b5-narrative, b5-board-inputs).
+
+Transient states no stored data can produce: the in-flight "generating" request on the narrative
+page, and the board-input validation errors (the live save endpoints answer those with a toast and
+leave the page as it is). Each preview renders the real page for a real assessment
+(``?assessment_id=``) with the state set here, as the S5 live previews do. Debug-only, like every
+``/design`` route.
+"""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from types import SimpleNamespace
+
+from fastapi import HTTPException, Request, Response
+from sqlalchemy.orm import Session
+
+from app.models.assessment import Assessment
+from app.routers import board_inputs as board_inputs_router
+from app.routers import drafting
+from app.routers.design import DB_PREVIEWS, PREVIEW_PAGES
+
+LONG_RECOMMENDATION = (
+    "Add a notification step to the incident procedure with named owners and a template. "
+    + "Name an owner for each step, agree the template with legal counsel and run a test notification before the next audit. " * 14
+)
+LONG_TITLE = "Strengthen incident response, notification routes and runbooks across every business unit and supplier"
+
+
+def _live_request(request: Request, path: str) -> Request:
+    # Render as if at the live URL so the shell, crumbs and context processors match the real page.
+    return Request(dict(request.scope, path=path, raw_path=path.encode()), request.receive)
+
+
+def _assessment(request: Request, db: Session, expected: tuple[str, ...]) -> tuple[Assessment, str]:
+    state = request.query_params.get("state")
+    assessment_id = request.query_params.get("assessment_id")
+    assessment = db.get(Assessment, assessment_id) if assessment_id else None
+    if state not in expected or assessment is None:
+        raise HTTPException(status_code=404, detail="Not found")
+    return assessment, state
+
+
+def narrative_preview(request: Request, db: Session = None) -> Response:
+    assessment, _state = _assessment(request, db, ("generating",))
+    live = _live_request(request, f"/assessments/{assessment.id}/narrative")
+    context = drafting.narrative_page_context(db, assessment, generating=True)
+    context["request"] = live
+    return drafting._templates.TemplateResponse(request=live, name="pages/narrative.html", context=context)
+
+
+def board_inputs_preview(request: Request, db: Session = None) -> Response:
+    assessment, _state = _assessment(request, db, ("error",))
+    live = _live_request(request, f"/assessments/{assessment.id}/board-inputs")
+    context = board_inputs_router.board_inputs_page_context(db, assessment)
+    views = list(context["page"].findings)
+    first = views[0].finding
+    long_copy = SimpleNamespace(
+        id=first.id, title=first.title, description=first.description,
+        business_impact=first.business_impact, recommendation=LONG_RECOMMENDATION,
+    )
+    views[0] = replace(views[0], finding=long_copy)
+    context["page"] = SimpleNamespace(findings=views, eligible=context["page"].eligible)
+    group = context["groups"][0]["group_id"]
+    initiative = dict(context["initiative_data"].get(group, {}), title=LONG_TITLE)
+    context["initiative_data"] = {**context["initiative_data"], group: initiative}
+    context["groups"] = context["groups"][:1]
+    context["field_errors"] = {
+        f"finding:{first.id}:recommendation": "Recommendation must be 1500 characters or fewer.",
+        f"initiative:{group}:title": "Initiative title must be 120 characters or fewer.",
+    }
+    context["request"] = live
+    return board_inputs_router._templates.TemplateResponse(
+        request=live, name="pages/board_inputs.html", context=context
+    )
+
+
+PREVIEW_PAGES["b5-narrative"] = narrative_preview
+PREVIEW_PAGES["b5-board-inputs"] = board_inputs_preview
+DB_PREVIEWS.update({"b5-narrative", "b5-board-inputs"})

diff --git a/design/harness/seed_s7_report.py b/design/harness/seed_s7_report.py
new file mode 100644
index 0000000..5a3f4ce
--- /dev/null
+++ b/design/harness/seed_s7_report.py
@@ -0,0 +1,178 @@
+"""S7 report group seed: the Report tab (b5-report) and its empty state (b5-no-report).
+
+Imported by ``seed_s7`` (it exposes ``SCREEN_STATES``, ``apply`` and ``route``). Builders come
+from ``seed_s4``; nothing there is edited. The released state seeds real conclusions, approvals
+and a real release (``approved_report.record_release``), so every number on the page is computed
+by the app. Only the loading skeleton is produced by a design preview fixture.
+"""
+
+from __future__ import annotations
+
+import json
+
+from sqlalchemy.orm import Session
+
+from app.models.assessment import Assessment
+from app.models.conclusion import Conclusion, ConclusionRevision
+from app.models.engagement import Engagement
+from app.models.report import GapReport
+from design.harness.seed_s4 import SEED_ACTOR, _time
+
+SCREEN_STATES = {
+    "b5-report": ("released", "not-released", "loading"),
+    "b5-no-report": ("default",),
+}
+
+# DPDPA: 24 in-scope requirements, 11 compliant, 7 partial, 4 non-compliant, 2 insufficient.
+# (control id, outcome, risk, gap text). Gap text echoes the mockup where the control matches.
+_DPDPA = (
+    ("CH2.CONSENT.1", "compliant", "low", "None."),
+    ("CH2.CONSENT.2", "compliant", "low", "None."),
+    ("CH2.CONSENT.3", "non_compliant", "high", "Withdrawal is possible only by emailing the data protection officer."),
+    ("CH2.NOTICE.1", "non_compliant", "high", "The privacy notice is available in English only."),
+    ("CH2.NOTICE.3", "compliant", "low", "None."),
+    ("CH2.PURPOSE.1", "compliant", "low", "None."),
+    ("CH2.PURPOSE.2", "partially_compliant", "medium", "Legitimate uses are listed but not mapped to systems."),
+    ("CH2.MINIMIZE.1", "compliant", "low", "None."),
+    ("CH2.MINIMIZE.3", "insufficient_evidence", "medium", "No schedule for payment dispute records."),
+    ("CH2.SECURITY.1", "partially_compliant", "medium", "Backups are not encrypted at rest."),
+    ("CH2.SECURITY.2", "partially_compliant", "high", "Access reviews skip two production systems."),
+    ("CH3.ACCESS.1", "compliant", "low", "None."),
+    ("CH3.CORRECT.1", "partially_compliant", "high", "Correction requests are handled by email with no deadline."),
+    ("CH3.CORRECT.2", "non_compliant", "medium", "Erasure requests are not tracked to completion."),
+    ("CH3.GRIEVANCE.1", "compliant", "low", "None."),
+    ("CH4.SDF.1", "compliant", "low", "None."),
+    ("CH4.SDF.4", "insufficient_evidence", "medium", "No audit report was provided."),
+    ("CM.RECORDS.1", "compliant", "low", "Register is complete and reviewed quarterly."),
+    ("CM.GRANULAR.1", "partially_compliant", "medium", "Marketing and analytics share one consent toggle."),
+    ("CB.TRANSFER.1", "compliant", "low", "None."),
+    ("BN.NOTIFY.1", "non_compliant", "critical", "No route to notify the Board and affected data principals."),
+    ("BN.NOTIFY.3", "partially_compliant", "high", "The incident response plan has not been tested."),
+    ("BN.NOTIFY.4", "compliant", "low", "None."),
+    ("CH3.GRIEVANCE.2", "partially_compliant", "low", "Responses are timely but not recorded."),
+)
+
+
+def _iso_rows() -> list[tuple[str, str, str, str]]:
+    """88 ISO 27001 controls: 38 compliant, 29 partial, 14 non-compliant, 7 insufficient."""
+    from app.frameworks.registry import FrameworkRegistry
+
+    controls = [control for control in FrameworkRegistry.get_all_controls("iso27001")][:88]
+    pattern = (
+        ["compliant"] * 38 + ["partially_compliant"] * 29 + ["non_compliant"] * 14 + ["insufficient_evidence"] * 7
+    )
+    # Interleave deterministically so every theme carries every outcome.
+    order = sorted(range(88), key=lambda index: (index * 37) % 88)
+    outcomes = [None] * 88
+    for position, index in enumerate(order):
+        outcomes[index] = pattern[position]
+    high_budget = 9
+    rows = []
+    for control, outcome in zip(controls, outcomes):
+        if outcome == "compliant":
+            risk, gap = "low", "None."
+        else:
+            risk = "high" if high_budget and outcome in ("non_compliant", "partially_compliant") else "medium"
+            high_budget -= 1 if risk == "high" else 0
+            gap = "Operation lags the documented control."
+        rows.append((control.id, outcome, risk, gap))
+    return rows
+
+
+def _scope(assessment: Assessment, framework_rows: dict[str, list]) -> None:
+    applicable = [row[0] for rows in framework_rows.values() for row in rows]
+    assessment.applicable_requirements = json.dumps(applicable)
+    assessment.scope_answers = json.dumps({})
+
+
+def _report(db: Session, assessment: Assessment, framework_scores: dict | None = None) -> None:
+    db.add(
+        GapReport(
+            id=f"gap-report-{assessment.id}",
+            assessment_id=assessment.id,
+            overall_score=0.0,
+            chapter_scores="{}",
+            executive_summary="Seeded analysis report.",
+            raw_ai_response="{}",
+            framework_scores=json.dumps(framework_scores) if framework_scores else None,
+            generated_at=_time(-12),
+        )
+    )
+    db.flush()
+
+
+def _conclusions(db: Session, assessment: Assessment, framework_id: str, rows, *, approved: int | None = None) -> None:
+    for index, (requirement_id, outcome, risk, gap) in enumerate(rows):
+        conclusion = Conclusion(
+            id=f"conclusion-report-{framework_id}-{index:03d}",
+            assessment_id=assessment.id,
+            framework_id=framework_id,
+            requirement_id=requirement_id,
+            outcome=outcome,
+            rationale="Seeded approved conclusion.",
+            evidence_summary="Seeded evidence summary.",
+            gaps_identified=gap,
+            risk_level=risk,
+            recommended_action="Close the gap and keep the evidence on file.",
+            ai_proposed=True,
+            created_at=_time(-12),
+            updated_at=_time(-11),
+        )
+        db.add(conclusion)
+        db.flush()
+        db.add(ConclusionRevision(id=f"revision-proposed-{conclusion.id}", conclusion_id=conclusion.id,
+                                  actor="system:analysis", action="proposed", created_at=_time(-12)))
+        if approved is None or index < approved:
+            db.add(ConclusionRevision(id=f"revision-approved-{conclusion.id}", conclusion_id=conclusion.id,
+                                      actor=SEED_ACTOR, action="approved", created_at=_time(-11)))
+    db.flush()
+
+
+def _release(db: Session, assessment: Assessment) -> None:
+    from app.models.audit_event import AuditEvent
+    from app.services import approved_report
+
+    approved_report.record_release(db, assessment, actor=SEED_ACTOR)
+    db.flush()
+    for event in db.query(AuditEvent).filter(
+        AuditEvent.action == "assessment.released", AuditEvent.entity_id == assessment.id
+    ):
+        event.created_at = _time(-6)  # the mockup releases on 24 Sep 2026
+    db.flush()
+
+
+def apply(db: Session, screen: str, state: str, assessment: Assessment, engagement: Engagement, data: dict) -> dict:
+    if screen == "b5-no-report":
+        return {"data_state": "database", "note": "Base assessment with no gap report."}
+
+    if state == "not-released":
+        # DPDPA: three in-scope conclusions, two approved. ISO 27001: analysis failed.
+        from app.services.scoring import failed_framework_scores
+
+        dpdpa = list(_DPDPA[:3])
+        iso = _iso_rows()[:2]
+        _scope(assessment, {"dpdpa": dpdpa, "iso27001": iso})
+        _report(db, assessment, {"iso27001": failed_framework_scores()})
+        _conclusions(db, assessment, "dpdpa", dpdpa, approved=2)
+        return {"data_state": "database", "note": "Two of three DPDPA conclusions approved; ISO 27001 stored as a failed analysis."}
+
+    dpdpa = list(_DPDPA)
+    iso = _iso_rows()
+    _scope(assessment, {"dpdpa": dpdpa, "iso27001": iso})
+    _report(db, assessment)
+    _conclusions(db, assessment, "dpdpa", dpdpa)
+    _conclusions(db, assessment, "iso27001", iso)
+    _release(db, assessment)
+    assessment.status = "completed"
+    if state == "loading":
+        return {
+            "data_state": "preview-state",
+            "note": "Released data behind /design/pages/b5-report-loading: the skeleton shows before report-summary loads.",
+        }
+    return {"data_state": "database", "note": "24 DPDPA and 88 ISO 27001 approved conclusions released through record_release."}
+
+
+def route(screen: str, state: str, assessment_id: str) -> str:
+    if screen == "b5-report" and state == "loading":
+        return f"/design/pages/b5-report-loading?assessment_id={assessment_id}"
+    return f"/assessments/{assessment_id}?tab=report"

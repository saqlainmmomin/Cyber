+{% block scripts %}
+<script data-conclusion-rows>
+(() => {
+  const labels = {
+    pending: '<span class="status"><span class="st"></span>Pending</span>',
+    approved: '<span class="status"><svg class="i"><use href="#i-check"/></svg> Approved</span>',
+    edited: '<span class="status"><svg class="i"><use href="#i-pen"/></svg> Edited and approved</span>',
+    rejected: '<span class="status"><svg class="i"><use href="#i-x"/></svg> Rejected</span>'
+  };
+  const setOpen = (row, open) => {
+    const detail = document.getElementById("conclusion-detail-" + row.dataset.conclusionRow);
+    if (!detail) return;
+    detail.hidden = !open;
+    row.setAttribute("aria-expanded", open ? "true" : "false");
+    const toggle = row.querySelector(".rv-toggle");
+    if (toggle) toggle.setAttribute("aria-expanded", open ? "true" : "false");
+  };
+  document.addEventListener("click", (event) => {
+    const row = event.target.closest && event.target.closest("tr.rv-row");
+    if (!row || (event.target.closest("a") && !event.target.closest(".rv-toggle"))) return;
+    setOpen(row, row.getAttribute("aria-expanded") !== "true");
+  });
+  // A card swap (approve, edit, reject, reopen) changes its decision: bring the row and counts in line.
+  const sync = () => {
+    const counts = { pending: 0, rejected: 0, approved: 0, edited: 0, legacy_bulk: 0 };
+    document.querySelectorAll("tr.rv-row").forEach((row) => {
+      const card = document.getElementById("conclusion-card-" + row.dataset.conclusionRow);
+      const state = card ? card.dataset.state : row.dataset.state;
+      if (state !== row.dataset.state) {
+        row.dataset.state = state;
+        row.removeAttribute("data-legacy");
+        const cell = row.querySelector("[data-decision-cell]");
+        if (cell && labels[state]) cell.innerHTML = labels[state];
+      }
+      if (row.dataset.legacy === "yes") counts.legacy_bulk += 1;
+      else if (counts[state] !== undefined) counts[state] += 1;
+    });
+    Object.keys(counts).forEach((key) => {
+      const node = document.querySelector('[data-count="' + key + '"]');
+      if (node) node.textContent = counts[key];
+      if (key === "legacy_bulk" && node && node.parentElement) node.parentElement.hidden = counts[key] === 0;
+    });
+  };
+  document.body.addEventListener("htmx:afterSwap", sync);
+})();
+</script>
+{% endblock %}

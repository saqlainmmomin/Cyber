diff --git a/design/yozora-patterns.css b/design/yozora-patterns.css
index d7341e8..24db316 100644
--- a/design/yozora-patterns.css
+++ b/design/yozora-patterns.css
@@ -258,3 +258,29 @@ button.item .txt{color:inherit}
 .followup-host{max-width:820px}
 .screening-run .htmx-indicator:not(.htmx-request){display:none}
 .screening-run:has(.htmx-indicator.htmx-request) [type=submit]{display:none}
+
+/* s7-cards */
+.cc-card{margin:0}
+.cc-pre{white-space:pre-line}
+.cc-hint{margin-left:var(--s-3);font-size:var(--t-sm);font-weight:400;color:var(--muted)}
+.cc-claims{list-style:none;display:flex;flex-direction:column;gap:var(--s-3)}
+.cc-claims + .cc-claims{margin-top:var(--s-3)}
+.cc-claims li.alert{margin-top:var(--s-1)}
+.cc-rfi-list{list-style:none;display:flex;flex-direction:column;gap:var(--s-4)}
+.cc-rfi-list > li{display:flex;flex-direction:column;gap:var(--s-4)}
+.cc-row{display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap}
+.cc-ack{display:flex;flex-direction:column;gap:var(--s-4);margin-top:var(--s-3)}
+.cc-form{display:flex;flex-direction:column;gap:var(--s-4)}
+.cc-blocker{margin:0 var(--s-10) var(--s-3)}
+.cc-drafting{display:none;flex-direction:column;gap:10px}
+.cc-drafting .skel:nth-child(1){width:94%}
+.cc-drafting .skel:nth-child(2){width:88%}
+.cc-drafting .skel:nth-child(3){width:52%}
+[data-recommended-action-field]:has([data-remediation-draft-button].htmx-request) .field.area{display:none}
+[data-recommended-action-field]:has([data-remediation-draft-button].htmx-request) .cc-drafting{display:flex}
+[data-remediation-draft-button].htmx-request{pointer-events:none;color:transparent;position:relative}
+[data-remediation-draft-button].htmx-request::after{content:"";position:absolute;width:14px;height:14px;border-radius:var(--r-full);border:2px solid var(--text-2);border-top-color:transparent;animation:spin .7s linear infinite}
+.cc-card:has([data-remediation-draft-button].htmx-request) [data-edit-actions] .btn.primary{color:var(--text);background:rgba(255,255,255,.88);box-shadow:inset 0 0 0 1px var(--line-control),0 1px 2px rgba(20,24,44,.05)}
+[data-theme=dark] .cc-card:has([data-remediation-draft-button].htmx-request) [data-edit-actions] .btn.primary{background:rgba(255,255,255,.07)}
+@media (max-width:860px){.cc-blocker{margin-left:var(--s-5);margin-right:var(--s-5)}}
+/* /s7-cards */

+++ b/app/routers/design_s7_analysis.py
@@ -0,0 +1,199 @@
+"""Design preview fixtures for the S7 "analysis" group (debug only, reached via /design/pages/<name>).
+
+Four screens have no page of their own: the analysis partials render into S5's questionnaire card,
+and the release and report-basis panels are included by the conclusions page that another group owns.
+Each fixture renders the real partial inside the standard assessment shell, with real data read from
+the database (``?assessment_id=``) and the specimen heading the approved mockups use. Nothing here
+changes data; the gate states call the same views the browser calls and render their context.
+"""
+
+from __future__ import annotations
+
+from fastapi import HTTPException, Request
+from fastapi.responses import Response
+
+from app.database import SessionLocal
+from app.models.assessment import Assessment
+from app.models.engagement import Engagement
+from app.models.report import GapItem
+from app.routers.design import PREVIEW_PAGES
+from app.routers.web import templates
+
+SHELL = """
+{% extends "base.html" %}
+{% from "components/layout.html" import assessment_tabs %}
+{% from "components/ui.html" import icon %}
+{% block title %}{{ heading }}{% endblock %}
+{% block crumbs %}<a class="hide-sm" href="/">{{ assessment.company_name }}</a>{{ icon("slash", style="") }}{% if engagement %}<a class="hide-sm" href="/engagements/{{ engagement.id }}">{{ engagement.name }}</a>{{ icon("slash") }}{% endif %}<a href="/assessments/{{ assessment.id }}">{{ assessment.display_name }}</a>{% for label, href in trail %}<svg class="i sl"><use href="#i-slash"/></svg>{% if href %}<a href="{{ href }}">{{ label }}</a>{% else %}<b>{{ label }}</b>{% endif %}{% endfor %}{% endblock %}
+{% macro specimen_head() %}<div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;margin-bottom:var(--s-4)"><span class="chip">State</span><h2>{{ specimen }}</h2></div>{% endmacro %}
+{% macro page_head(first=False) %}<div class="page-head"{% if first %} style="margin-top:0"{% endif %}><div><h1>{{ heading }}</h1><p class="meta-line">{{ meta_line }}</p></div><div class="acts"></div></div>{{ assessment_tabs(assessment, tab) }}{% endmacro %}
+{% block content %}
+{% if head_inside %}
+<section style="margin-top:var(--s-12)">{{ specimen_head() }}{{ page_head(True) }}
+{% else %}
+{{ page_head() }}
+<section style="margin-top:var(--s-12)">{{ specimen_head() }}
+{% endif %}
+{% if layout == "analysis" %}
+<div class="glass card" style="margin-top:var(--s-4)"><div id="analysis-area">{% include partial %}</div></div>
+{% elif layout == "confirm" %}
+<div style="position:relative;min-height:400px">{% include partial %}</div>
+<style>#release-modal{position:absolute;border-radius:var(--r-lg)}</style>
+<script>(() => { const modal = document.getElementById("release-modal"); if (modal) modal.hidden = false; })();</script>
+{% elif layout == "finding" %}
+{% include partial %}
+{% else %}
+{% include partial %}
+{% endif %}
+{% if toast %}<div style="margin-top:var(--s-4)"><div class="toast">{{ icon("check") }}{{ toast }}</div></div>{% endif %}
+</section>
+{% endblock %}
+"""
+
+STATE_HEADS = {
+    "b5-analysis": {
+        "running": "Running",
+        "complete": "Complete",
+        "error": "Failed for one framework",
+        "error-all": "Failed with no detail",
+        "gate": "Blocked by an incomplete questionnaire",
+        "gate-no-override": "Blocked, no override offered",
+    },
+    "b5-release": {
+        "blocked": "Not ready",
+        "ready": "Ready",
+        "confirm": "Confirming the release",
+        "released": "Released",
+        "stale": "Out of date after release",
+    },
+    "b5-basis": {
+        "empty": "Not recorded",
+        "filled": "Recorded",
+        "invalid": "Invalid dates",
+        "locked": "Locked",
+        "saved": "Saved",
+    },
+    "b5-review-finding-card": {
+        "draft": "Draft",
+        "needs-review": "Flagged for review, no quote",
+        "notes": "Adding notes",
+        "accepted": "Accepted",
+        "rejected": "Rejected with notes",
+    },
+}
+
+# Same wording the routes send as toast headers (app/routers/review.py).
+SAVED_TOAST = "Period and sign-off saved"
+RELEASED_TOAST = "Report released"
+
+
+def _meta_line(basis) -> str:
+    from app.template_config import display_date
+
+    if not basis.period_recorded:
+        return "Period not set · Evidence cut-off not set"
+    return (
+        f"{display_date(basis.period_start)} – {display_date(basis.period_end)}"
+        f" · Evidence cut-off {display_date(basis.evidence_cutoff)}"
+    )
+
+
+def _analysis_context(request: Request, db, assessment: Assessment, state: str) -> tuple[str, dict]:
+    from app.routers import web
+    from app.routers.analysis import COMPLETION_OVERRIDE_REASONS
+
+    if state in {"gate", "gate-no-override"}:
+        previous = assessment.status
+        # The real route; the gate refuses before any model call. Status is restored by the route.
+        response = web.run_analysis_web(request, assessment.id, override_reason="", reviewer_name="", db=db)
+        db.refresh(assessment)
+        assessment.status = previous
+        context = dict(response.context)
+        context.setdefault("override_reasons", COMPLETION_OVERRIDE_REASONS)
+        return response.template.name, context
+    response = web.analysis_status(request, assessment.id, db=db)
+    return response.template.name, dict(response.context)
+
+
+def _page(request: Request, screen: str) -> Response:
+    state = request.query_params.get("state", "")
+    if state not in STATE_HEADS[screen]:
+        raise HTTPException(status_code=404, detail="Not found")
+    with SessionLocal() as db:
+        assessment_id = request.query_params.get("assessment_id")
+        assessment = db.get(Assessment, assessment_id) if assessment_id else db.query(Assessment).first()
+        if assessment is None:
+            raise HTTPException(status_code=404, detail="Not found")
+        engagement = db.get(Engagement, assessment.engagement_id) if assessment.engagement_id else None
+        return _render(request, db, screen, state, assessment, engagement)
+
+
+def _render(request: Request, db, screen: str, state: str, assessment: Assessment, engagement) -> Response:
+    from app.services import approved_report, report_basis
+
+    basis = report_basis.current_basis(db, assessment)
+    context: dict = {
+        "request": request,
+        "assessment": assessment,
+        "engagement": engagement,
+        "specimen": STATE_HEADS[screen][state],
+        "layout": "plain",
+        "head_inside": False,
+        "toast": "",
+        "preview_static": True,
+        "meta_line": _meta_line(basis),
+    }
+    review_trail = [("Review", f"/assessments/{assessment.id}/review-queue")]
+    report_trail = [("Report", f"/assessments/{assessment.id}/report")]
+
+    if screen == "b5-analysis":
+        partial, extra = _analysis_context(request, db, assessment, state)
+        context.update(extra)
+        context.update(
+            heading="Review", tab="review", partial=partial, layout="analysis",
+            trail=[*review_trail, ("Review", "")],
+        )
+    elif screen == "b5-release":
+        release = approved_report.release_state(db, assessment)
+        context.update(
+            heading="Release", tab="report", partial="partials/release_panel.html", release=release,
+            trail=[*report_trail, ("Release", "")],
+        )
+        if state == "confirm":
+            context["layout"] = "confirm"
+        if state == "released":
+            context["toast"] = RELEASED_TOAST
+    elif screen == "b5-basis":
+        field_errors = {}
+        shown = basis
+        if state == "empty":
+            shown = report_basis.EMPTY_BASIS
+            context["meta_line"] = _meta_line(shown)
+        if state == "invalid":
+            field_errors = {"period_end": "The period end must be after the period start."}
+            from dataclasses import replace
+            from datetime import timedelta
+
+            shown = replace(basis, period_end=basis.period_start - timedelta(days=1))
+        context.update(
+            heading="Period and sign-off", tab="report", partial="partials/report_basis_panel.html",
+            report_basis=shown, period_locked=report_basis.period_locked(db, assessment),
+            field_errors=field_errors, head_inside=True,
+            trail=[*report_trail, ("Period and sign-off", "")],
+            toast=SAVED_TOAST if state == "saved" else "",
+        )
+    else:
+        item = db.query(GapItem).order_by(GapItem.id).first()
+        if item is None:
+            raise HTTPException(status_code=404, detail="Not found")
+        context.update(
+            heading="Finding review", tab="review", partial="partials/review_finding_card.html",
+            item=item, layout="finding", notes_open=state == "notes",
+            trail=[*review_trail, ("Findings", f"/assessments/{assessment.id}/findings"), ("Finding review", "")],
+        )
+    context["assessment_id"] = assessment.id
+    return templates.TemplateResponse(request=request, name=templates.env.from_string(SHELL), context=context)
+
+
+for _screen in STATE_HEADS:
+    PREVIEW_PAGES[_screen] = lambda request, screen=_screen: _page(request, screen)

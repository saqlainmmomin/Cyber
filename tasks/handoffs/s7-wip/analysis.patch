+    try:
+        document_count = len(analysis_documents(db, assessment_id))
+        response_count = (
+            db.query(QuestionnaireResponse)
+            .filter(
+                QuestionnaireResponse.assessment_id == assessment_id,
+                confirmed_response_clause(),
+            )
+            .filter(~QuestionnaireResponse.question_id.like("FU.%"))
+            .filter(func.trim(func.coalesce(QuestionnaireResponse.answer, "")) != "")
+            .count()
+        )
+    except Exception:
+        logger.warning("Analysis input counts unavailable", extra={"assessment_id": assessment_id}, exc_info=True)
+        return {}
+    return {"document_count": document_count, "response_count": response_count}
+

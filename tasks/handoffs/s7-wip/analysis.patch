+    {% if review_state == 'accepted' or review_state == 'rejected' %}
+    <button class="btn ghost" type="button"
+            hx-patch="/api/assessments/{{ assessment.id }}/review/items/{{ item.id }}"
+            hx-vals='{"review_status": "draft"}'
+            hx-target="#review-card-{{ item.id }}"
+            hx-swap="outerHTML">Change decision</button>
+    {% else %}
+    <button class="btn primary" type="button"
+            hx-patch="/api/assessments/{{ assessment.id }}/review/items/{{ item.id }}"
+            hx-vals='{"review_status": "accepted"}'
+            hx-target="#review-card-{{ item.id }}"
+            hx-swap="outerHTML">Accept</button>
+    <button class="btn danger" type="button"
+            hx-patch="/api/assessments/{{ assessment.id }}/review/items/{{ item.id }}"
+            hx-vals='{"review_status": "rejected"}'
+            hx-target="#review-card-{{ item.id }}"
+            hx-swap="outerHTML">Reject</button>
+    <button class="btn ghost sm lead" type="button" data-notes-toggle{% if notes_visible %} hidden{% endif %}>{{ icon("pen") }}{{ "Edit notes" if item.reviewer_notes else "Add notes" }}</button>
+    {% endif %}
   </div>
+  <script>
+  (() => {
+    if (window.__reviewNotesToggle) return;
+    window.__reviewNotesToggle = true;
+    document.addEventListener("click", (event) => {
+      const toggle = event.target.closest("[data-notes-toggle]");
+      if (!toggle) return;
+      const card = toggle.closest("[data-review-card]");
+      const panel = card && card.querySelector("[data-notes-panel]");
+      if (!panel) return;
+      panel.hidden = false;
+      toggle.hidden = true;
+      const field = panel.querySelector("textarea");
+      if (field) field.focus();
+    });
+  })();
+  </script>
 </div>
diff --git a/design/harness/seed_s7_analysis.py b/design/harness/seed_s7_analysis.py
new file mode 100644
index 0000000..34afe68
--- /dev/null
+++ b/design/harness/seed_s7_analysis.py
@@ -0,0 +1,242 @@
+"""S7 group "analysis": analysis states, release panel, report basis panel, finding review card.
+
+Mockups: b5-analysis, b5-release, b5-basis, b5-review-finding-card. All four render through
+``/design/pages/<screen>?state=<state>&assessment_id=<id>`` (``app/routers/design_s7_analysis.py``):
+the partials are fragments with no page of their own, or are included by pages another group owns.
+The fixture reads real data from the seeded database; what the seed cannot produce is listed in
+each ``note``.
+"""
+
+from __future__ import annotations
+
+import json
+
+from design.harness.seed_s4 import SEED_ACTOR, _audit, _time
+
+SCREEN_STATES = {
+    "b5-analysis": ("running", "complete", "error", "error-all", "gate", "gate-no-override"),
+    "b5-release": ("blocked", "ready", "confirm", "released", "stale"),
+    "b5-basis": ("empty", "filled", "invalid", "locked", "saved"),
+    "b5-review-finding-card": ("draft", "needs-review", "notes", "accepted", "rejected"),
+}
+
+PREPARED_BY = "Arjun Mehta"
+REVIEWED_BY = "Priya Sharma"
+
+
+def route(screen: str, state: str, assessment_id: str) -> str:
+    return f"/design/pages/{screen}?state={state}&assessment_id={assessment_id}"
+
+
+def _controls(assessment, per_framework: int = 3) -> dict[str, list]:
+    from app.frameworks.registry import FrameworkRegistry
+
+    return {
+        framework_id: list(FrameworkRegistry.get_all_controls(framework_id)[:per_framework])
+        for framework_id in assessment.frameworks
+    }
+
+
+def _gap_report(db, assessment, framework_scores: dict | None = None) -> None:
+    from app.models.report import GapReport
+
+    db.add(
+        GapReport(
+            id=f"gap-report-{assessment.id}",
+            assessment_id=assessment.id,
+            overall_score=0.0,
+            chapter_scores="{}",
+            executive_summary="Seeded analysis report.",
+            raw_ai_response="{}",
+            framework_scores=json.dumps(framework_scores) if framework_scores else None,
+            generated_at=_time(-1),
+        )
+    )
+    db.flush()
+
+
+def _conclusions(db, assessment, approved: dict[str, int], per_framework: int = 3) -> None:
+    """Three in-scope conclusions per framework; the first ``approved[framework]`` are approved."""
+    from app.models.conclusion import Conclusion, ConclusionRevision
+
+    controls = _controls(assessment, per_framework)
+    assessment.applicable_requirements = json.dumps(
+        [control.id for framework_controls in controls.values() for control in framework_controls]
+    )
+    assessment.scope_answers = json.dumps({})
+    db.flush()
+    for framework_id, framework_controls in controls.items():
+        for index, control in enumerate(framework_controls):
+            conclusion = Conclusion(
+                id=f"conclusion-s7a-{framework_id}-{index}",
+                assessment_id=assessment.id,
+                framework_id=framework_id,
+                requirement_id=control.id,
+                outcome="partially_compliant",
+                rationale="Seeded conclusion.",
+                evidence_summary="Seeded evidence summary.",
+                gaps_identified="Seeded gap.",
+                risk_level="medium",
+                recommended_action="Seeded recommendation.",
+                ai_proposed=True,
+                created_at=_time(-6),
+                updated_at=_time(-5),
+            )
+            db.add(conclusion)
+            db.flush()
+            db.add(ConclusionRevision(id=f"revision-proposed-{conclusion.id}", conclusion_id=conclusion.id,
+                                      actor="system:analysis", action="proposed", created_at=_time(-6)))
+            if index < approved.get(framework_id, 0):
+                db.add(ConclusionRevision(id=f"revision-approved-{conclusion.id}", conclusion_id=conclusion.id,
+                                          actor=SEED_ACTOR, action="approved", created_at=_time(-5)))
+    db.flush()
+
+
+def _basis_names(db, assessment) -> None:
+    """Record the sign-off names the basis mockup shows, on top of the base period event."""
+    db.add(
+        _audit(
+            f"audit-basis-names-{assessment.id}",
+            action="assessment.report_basis_updated",
+            entity_type="assessment",
+            entity_id=assessment.id,
+            created_at=_time(-26),
+            metadata={
+                "after": {
+                    "period_start": "2025-04-01",
+                    "period_end": "2026-03-31",
+                    "evidence_cutoff": "2026-03-15",
+                    "prepared_by": PREPARED_BY,
+                    "reviewed_by": REVIEWED_BY,
+                }
+            },
+        )
+    )
+    db.flush()
+
+
+def _release(db, assessment) -> None:
+    from app.services import approved_report
+
+    event = approved_report.record_release(db, assessment, actor=SEED_ACTOR)
+    event.created_at = _time(-6)  # 24 Sep 2026
+    db.flush()
+
+
+def _finding_item(db, assessment, state: str) -> None:
+    from app.models.report import GapItem
+
+    _gap_report(db, assessment)
+    quote = (
+        None
+        if state == "needs-review"
+        else "The consent preference page lets users view their choices. "
+        "Changes are requested through the data protection officer."
+    )
+    db.add(
+        GapItem(
+            id="gap-item-s7-consent",
+            report_id=f"gap-report-{assessment.id}",
+            requirement_id="CH2.CONSENT.3",
+            framework_id="dpdpa",
+            chapter="Consent",
+            requirement_title="Consent withdrawal mechanism",
+            compliance_status="non_compliant",
+            current_state="Withdrawal is by email only.",
+            gap_description=(
+                "Users cannot withdraw consent in the product. "
+                "The only route is an email to the data protection officer."
+            ),
+            risk_level="high",
+            remediation_action="Add a withdrawal control to the preference page.",
+            remediation_priority=1,
+            remediation_effort="medium",
+            timeline_weeks=6,
+            evidence_quote=quote,
+            evidence_confidence="weak",
+            review_status={"accepted": "accepted", "rejected": "rejected"}.get(state, "draft"),
+            needs_review=state == "needs-review",
+            ai_compliance_status="non_compliant",
+            ai_risk_level="high",
+            reviewer_notes=(
+                "The mechanism exists in the mobile app. Evidence is for the web product only."
+                if state == "rejected"
+                else None
+            ),
+        )
+    )
+    db.flush()
+
+
+def apply(db, screen, state, assessment, engagement, data) -> dict:
+    from design.harness.seed_s5 import _seed_documents, _seed_questionnaire_responses
+
+    if screen == "b5-analysis":
+        if state == "running":
+            assessment.status = "analyzing"
+            _seed_documents(db, engagement, assessment, 14, "s7a")
+            _seed_questionnaire_responses(db, assessment, complete=True)
+            return {"data_state": "database", "note": "Assessment status analyzing; 14 documents and the full questionnaire seeded, counts read live."}
+        if state == "complete":
+            assessment.status = "completed"
+            _gap_report(db, assessment)
+            _conclusions(db, assessment, {"dpdpa": 2, "iso27001": 1})
+            return {"data_state": "database", "note": "Completed analysis with 2 of 3 DPDPA and 1 of 3 ISO 27001 conclusions approved; panel rendered from analysis_status."}
+        if state == "error":
+            from app.services.scoring import failed_framework_scores
+
+            assessment.status = "error"
+            _gap_report(db, assessment, {"iso27001": failed_framework_scores()})
+            _conclusions(db, assessment, {"dpdpa": 0})
+            return {"data_state": "database", "note": "Stored report marks ISO 27001 failed; panel rendered from analysis_status."}
+        if state == "error-all":
+            assessment.status = "error"
+            return {"data_state": "database", "note": "Assessment status error with no stored report; panel rendered from analysis_status."}
+        if state == "gate":
+            assessment.status = "created"
+            _seed_documents(db, engagement, assessment, 14, "s7a")
+            return {"data_state": "database", "note": "Run-analysis refused by the real completion gate (documents, empty questionnaire)."}
+        assessment.status = "created"
+        assessment.applicable_requirements = json.dumps([])
+        return {"data_state": "database", "note": "No evidence and no in-scope questions: the real run-analysis route refuses with no override."}
+
+    if screen == "b5-release":
+        _gap_report(db, assessment)
+        if state == "blocked":
+            _conclusions(db, assessment, {"dpdpa": 3, "iso27001": 0})
+            return {"data_state": "database", "note": "3 of 6 conclusions approved, so the real release blockers show."}
+        _conclusions(db, assessment, {"dpdpa": 3, "iso27001": 3})
+        if state in {"released", "stale"}:
+            _release(db, assessment)
+        if state == "stale":
+            from app.models.conclusion import Conclusion
+
+            conclusion = db.get(Conclusion, "conclusion-s7a-dpdpa-0")
+            conclusion.version += 1
+            conclusion.rationale = "Seeded conclusion, changed after release."
+            db.flush()
+        note = "confirm shows the closed panel with the confirm modal opened by the fixture" if state == "confirm" else "real release state"
+        return {"data_state": "preview-state" if state == "confirm" else "database", "note": note}
+
+    if screen == "b5-basis":
+        if state == "empty":
+            return {"data_state": "preview-state", "note": "The base seed always records a period; the fixture renders the panel with an empty basis."}
+        _basis_names(db, assessment)
+        if state == "locked":
+            _gap_report(db, assessment)
+            _conclusions(db, assessment, {"dpdpa": 2, "iso27001": 0})
+            return {"data_state": "database", "note": "Approved conclusions lock the period (real period_locked)."}
+        if state == "invalid":
+            return {"data_state": "preview-state", "note": "The route answers invalid dates with a toast; the fixture shows the in-field error."}
+        if state == "saved":
+            return {"data_state": "database", "note": "Recorded basis; the fixture appends the save confirmation row."}
+        return {"data_state": "database", "note": "Recorded period and sign-off names."}
+
+    # b5-review-finding-card
+    _finding_item(db, assessment, state)
+    return {
+        "data_state": "preview-state" if state == "notes" else "database",
+        "note": "Legacy gap item seeded with the state's review status; the notes editor is opened by the fixture."
+        if state == "notes"
+        else "Legacy gap item seeded with the state's review status and flags.",
+    }
